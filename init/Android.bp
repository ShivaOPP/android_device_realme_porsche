prebuilt_etc {
    name: "fstab.porsche",
    filename: "fstab.default",
    src: "fstab.default",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "init.porsche.rc",
    src: "init.porsche.rc",
    sub_dir: "init",
    device_specific: true,
}

prebuilt_etc {
    name: "init.porsche.perf.rc",
    src: "init.porsche.perf.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    // The new common tree owns init.target.rc; preserve this legacy module separately.
    name: "init.target.porsche.legacy.rc",
    filename: "init.target.porsche.legacy.rc",
    src: "init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.porsche.rc",
    filename: "ueventd.rc",
    src: "ueventd.porsche.rc",
    device_specific: true,
}
