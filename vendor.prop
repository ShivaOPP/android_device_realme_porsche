# Porsche-only values not supplied by the booting Android 17 base.
# Audio

# Bluetooth
persist.sys.fflag.override.settings_bluetooth_hearing_aid=true
persist.vendor.qcom.bluetooth.a2dp_mcast_test.enabled=false
persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=true
persist.vendor.qcom.bluetooth.scram.enabled=false
persist.vendor.qcom.bluetooth.twsp_state.enabled=false
vendor.hw.fm.init=0

# Enable incremental fs

# Crypto

# Display
debug.sf.frame_rate_multiple_threshold=60
ro.surface_flinger.refresh_rate_switching=true
ro.surface_flinger.set_display_power_timer_ms=1000

# Dolby
vendor.audio.dolby.ds2.enabled=false
vendor.audio.dolby.ds2.hardbypass=false
ro.vendor.dolby.model=PAFM00
ro.vendor.dolby.device=OP46C3
ro.vendor.dolby.manufacturer=OPLUS
ro.vendor.dolby.brand=OPLUS

# DPM

# Fingerprint

# Fuse Passthrough

# FRP

# qteeconnector settings

# RIL

# Sensors

# SPU

# Primary device values from the booting seventeen Porsche tree.
# Bluetooth
bluetooth.device.default_name=realme GT 2

# Fingerprint
persist.vendor.fp.template_updateflag=V1

# Graphics
ro.surface_flinger.set_idle_timer_ms=4000
ro.surface_flinger.set_touch_timer_ms=4000

# Radio
persist.radio.multisim.config=dsds

# USB
vendor.usb.product_string=realme GT 2
